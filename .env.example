DATABASE_URL=postgresql://camnova:camnova_local_only@localhost:5432/camnova
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set these before the initial seed. The seed never resets existing passwords.
SEED_ADMIN_EMAIL=owner@example.test
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_STAFF_EMAIL=staff@example.test
SEED_STAFF_PASSWORD=replace-with-another-strong-password

# Set false for a real business database; demo bookings are fictional.
SEED_DEMO=true
